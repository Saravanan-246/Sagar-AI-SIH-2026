PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Which LLM phrases Sagar's answers: "ollama" (local, no internet, no key)
# or "openrouter" (cloud). Defaults to openrouter. In both cases the LLM
# only rewords facts the deterministic services already computed, and any
# failure falls back to Sagar's deterministic narrator.
LLM_PROVIDER=ollama

# Local Ollama server (LLM_PROVIDER=ollama). Requires `ollama serve`
# running and the model already pulled - no API key, no internet access.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_MS=30000

# Cloud provider (LLM_PROVIDER=openrouter). Server-side only - never
# expose this key to the frontend.
# OPENROUTER_API_KEY=YOUR_KEY_HERE
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-chat-latest
