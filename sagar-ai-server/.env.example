PORT=4000
NODE_ENV=development

# Browser origins allowed to call this API (comma-separated, exact match).
# In development any localhost or private-LAN origin (e.g. a phone opening
# http://192.168.x.x:5173) is also allowed automatically; production uses
# this list only. Rejected origins are logged as "[cors] Rejected ...".
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

LLM_PROVIDER=ollama

# Ollama stays local to this PC - phones never talk to it directly; they
# reach this server, which calls Ollama over loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_MS=30000

# Optional cloud LLM
# OPENROUTER_API_KEY=YOUR_KEY_HERE
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-chat-latest
