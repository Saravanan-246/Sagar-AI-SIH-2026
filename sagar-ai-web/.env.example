# Development:
# Leave VITE_API_BASE_URL unset. The frontend derives the backend URL from
# the page host (desktop localhost:5173 -> localhost:4000; a phone on the
# LAN at 192.168.x.x:5173 -> 192.168.x.x:4000). Over https (npm run
# dev:https) API calls go through the Vite dev proxy instead.
# Rules: src/services/api/apiBaseUrl.ts

# Production (required):
# VITE_API_BASE_URL=https://your-backend.example.com

# Optional: show the developer diagnostics panel in a production build.
# VITE_SHOW_DIAGNOSTICS=true
